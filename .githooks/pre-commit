#!/usr/bin/env bash
# Pre-commit gate: reject formatting drift and vet errors before they reach CI.
# Enable once per clone:
#   git config core.hooksPath .githooks
# Bypass a single commit with --no-verify when you must.
set -euo pipefail

echo "pre-commit: gofmt"
drift="$(gofmt -l .)"
if [ -n "$drift" ]; then
  echo "gofmt required for:" >&2
  echo "$drift" >&2
  exit 1
fi

echo "pre-commit: go vet"
go vet ./...

# golangci-lint is optional locally (CI runs it in a pinned container); run it
# only when it's on PATH so contributors without it can still commit.
if command -v golangci-lint >/dev/null 2>&1; then
  echo "pre-commit: golangci-lint"
  golangci-lint run ./...
fi

echo "pre-commit: OK"
