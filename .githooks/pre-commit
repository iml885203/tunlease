#!/usr/bin/env bash
# Pre-commit gate: reject formatting drift, vet errors, and lint errors before
# they reach CI.
# Enable once per clone:
#   git config core.hooksPath .githooks
# Bypass a single commit with --no-verify when you must.
set -euo pipefail

echo "pre-commit: gofmt"
drift="$(gofmt -l .)"
if [ -n "$drift" ]; then
  echo "gofmt required for:" >&2
  echo "$drift" >&2
  exit 1
fi

echo "pre-commit: go vet"
go vet ./...

echo "pre-commit: golangci-lint"
make lint

echo "pre-commit: OK"
